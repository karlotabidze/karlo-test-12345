# Authorized Administrator Google Emails (comma-separated, case-insensitive)
ADMIN_EMAILS=karlotabidze@gmail.com

# PostgreSQL Connection (Object Method — Cloud SQL or Supabase PostgreSQL on Render)
SQL_HOST=
SQL_PORT=5432
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_SSL=false

# Drizzle Kit Schema Migration Admin Credentials
SQL_ADMIN_USER=
