# Google Maps Platform API Key (Maps JavaScript API & Places API New)
VITE_GOOGLE_MAPS_API_KEY=

# Optional Supabase Storage Configuration (falls back to managed /uploads directory when unset)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=saqotravel-media

# Optional Live Flight Schedule API Key (kept separate from curated manual flight routes)
AVIATIONSTACK_API_KEY=
